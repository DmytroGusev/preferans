#!/usr/bin/env bash
# Run the screenshot suites (RedesignScreenshotTests + the online/multiplayer
# OnlineScreensScreenshotTests) and dump the captured PNGs into one timestamped
# folder so you can review the attachment-based smoke states and the named
# playthrough buckets without clicking through the .xcresult bundle.
#
# Output: bin/.screens/<run-id>/*.png  (always written, even on test failure)
#
# Usage:
#   bin/screens                 # build-for-testing + run + extract PNGs
#   bin/screens --no-build      # skip the build phase (after first run)
#   bin/screens --only-testing PreferansUITests/RedesignScreenshotTests/testCaptureRedesignScreens
#   bin/screens --no-open       # keep the run fully headless
#   bin/screens --keep-runs 5   # prune older runs
#   DEST_NAME='iPhone 17 Pro' bin/screens
#   DEST_ID='<simulator UDID>' bin/screens  # exact runtime, preferred in CI

set -euo pipefail

source "$(dirname "$0")/lib/xcode-sim.sh"
preferans_cd_repo_root

SCHEME="${SCHEME:-Preferans}"
DEST_NAME="${DEST_NAME:-iPhone 17 Pro}"
DERIVED="${DERIVED:-build/DerivedData}"
KEEP_RUNS="${KEEP_RUNS:-3}"
DO_BUILD=1
OPEN_OUTPUT=1
ONLY_TESTS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --keep-runs) KEEP_RUNS="$2"; shift 2;;
    --no-build)  DO_BUILD=0; shift;;
    --no-open)   OPEN_OUTPUT=0; shift;;
    --only-testing) ONLY_TESTS+=("$2"); shift 2;;
    -h|--help)
      preferans_help_from_header "$0"
      exit 0;;
    *) echo "Unknown flag: $1" >&2; exit 64;;
  esac
done

OUT_ROOT="bin/.screens"
RUN_ID="$(date +%Y%m%d-%H%M%S)"
OUT_DIR="$OUT_ROOT/$RUN_ID"
RESULT_BUNDLE="$OUT_ROOT/$RUN_ID.xcresult"
mkdir -p "$OUT_DIR"

# File-based buckets are scratch output from the test runner. Clear them before
# launching the suite so an early test-process failure cannot make this run
# collect frames from a previous commit.
find build -mindepth 1 -maxdepth 1 -type d -name 'screens*' -exec rm -rf {} +

# Prune older runs (keep most recent KEEP_RUNS).
if [[ -d "$OUT_ROOT" ]]; then
  # shellcheck disable=SC2012
  ls -1dt "$OUT_ROOT"/*/ 2>/dev/null | tail -n +"$((KEEP_RUNS + 1))" | xargs -I{} rm -rf {} || true
  ls -1dt "$OUT_ROOT"/*.xcresult 2>/dev/null | tail -n +"$((KEEP_RUNS + 1))" | xargs -I{} rm -rf {} || true
fi

if [[ -n "${DEST_ID:-}" ]]; then
  DEST="platform=iOS Simulator,id=$DEST_ID"
else
  DEST="$(preferans_destination "$DEST_NAME")"
fi

if [[ "$DO_BUILD" -eq 1 ]]; then
  echo "[screens] build-for-testing ($DEST_NAME)"
  preferans_build_for_testing "$SCHEME" "$DEST" "$DERIVED"
fi

# --no-build requires reusable products that match every source input.
python3 bin/lib/screen-provenance.py check "$DERIVED/.preferans-test-build.json"
cp "$DERIVED/.preferans-test-build.json" "$OUT_DIR/build-source.json"

echo "[screens] running selected screenshot tests on $DEST_NAME"
# Tell the playthrough tests where to dump their secondary PNG bucket.
# Without this they fall back to NSTemporaryDirectory, which works but
# isn't where you'd look. xcodebuild only forwards env vars that carry
# the TEST_RUNNER_ prefix (it strips the prefix before injecting them
# into the runner), so a bare PREFERANS_SCREEN_DIR never arrives.
export TEST_RUNNER_PREFERANS_SCREEN_DIR="$(pwd)/build"
TEST_SELECTORS=()
if [[ ${#ONLY_TESTS[@]} -eq 0 ]]; then
  ONLY_TESTS=(
    "PreferansUITests/RedesignScreenshotTests"
    "PreferansUITests/OnlineScreensScreenshotTests"
  )
fi
for test_id in "${ONLY_TESTS[@]}"; do
  TEST_SELECTORS+=("-only-testing:$test_id")
done
set +e
preferans_test_without_building "$SCHEME" "$DEST" "$DERIVED" \
  "${TEST_SELECTORS[@]}" \
  -resultBundlePath "$RESULT_BUNDLE"
TEST_STATUS=$?
set -e

# xcrun xcresulttool extract-attachments lands in Xcode 16+; fall back to a
# manual walk of the legacy schema for older toolchains.
# Probe the *subcommand* directly — `export attachments` is nested and does
# not show up in the top-level `xcresulttool help`, so grepping that gave a
# false negative and silently skipped extraction (0 PNGs despite a green run).
if xcrun xcresulttool export attachments --help >/dev/null 2>&1; then
  echo "[screens] extracting attachments via xcresulttool"
  xcrun xcresulttool export attachments \
    --path "$RESULT_BUNDLE" \
    --output-path "$OUT_DIR" >/dev/null
else
  echo "[screens] toolchain lacks 'export attachments' — open the .xcresult manually:"
  echo "          open $RESULT_BUNDLE"
fi

# The longer playthroughs write deduplicated reference frames directly to
# build/screens* instead of adding hundreds of XCTest attachments. Collect
# those buckets into this run as well so bin/screens-latest represents the
# complete render pass, not only the attachment-based smoke states.
while IFS= read -r bucket; do
  bucket_name="$(basename "$bucket")"
  bucket_out="$OUT_DIR/$bucket_name"
  mkdir -p "$bucket_out"
  find "$bucket" -maxdepth 1 -type f -name '*.png' -exec cp {} "$bucket_out/" \;
done < <(find build -mindepth 1 -maxdepth 1 -type d -name 'screens*' -print)

# Surface a flat, human-readable PNG list.
COUNT="$(find "$OUT_DIR" -name '*.png' | wc -l | tr -d ' ')"
python3 bin/lib/screen-provenance.py capture "$OUT_DIR/build-source.json" \
  "$OUT_DIR/capture.json" "$TEST_STATUS" "$DEST" "${ONLY_TESTS[@]}"
echo "[screens] captured $COUNT PNG(s) in $OUT_DIR"
if [[ "$COUNT" -gt 0 && "$OPEN_OUTPUT" -eq 1 ]]; then
  open "$OUT_DIR"
fi

exit $TEST_STATUS
