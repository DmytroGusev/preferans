#!/usr/bin/env bash
# Return the newest completed capture only when it matches current source.
# Exit 2: no captures. Exit 3: missing provenance or stale source.
set -euo pipefail
source "$(dirname "$0")/lib/xcode-sim.sh"
preferans_cd_repo_root

python3 - "${1:-}" <<'PY'
import importlib.util
from pathlib import Path
import sys

sys.dont_write_bytecode = True

spec = importlib.util.spec_from_file_location("provenance", "bin/lib/screen-provenance.py")
provenance = importlib.util.module_from_spec(spec)
spec.loader.exec_module(provenance)
root = Path("bin/.screens")
runs = sorted((p for p in root.glob("*") if p.is_dir() and any(p.rglob("*.png"))), reverse=True)
if not runs:
    print("[screens-latest] No rendered screenshots. Run bin/screens.", file=sys.stderr)
    sys.exit(2)
latest = runs[0]
# Exporting an old xcresult gives its PNGs a fresh modification time; that
# cannot establish which source produced the pixels. Legacy runs fail closed.
if not provenance.check(latest / "capture.json"):
    sys.exit(3)
print(latest.resolve())
PY
