    "rules.odesa.poolClosing" : {
      "comment" : "Odesa pool-closing explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Each player closes an individual pool. Surplus is transferred through American aid." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Каждый игрок закрывает свою пулю. Избыток переносится через американскую помощь." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Кожен гравець закриває власну пулю. Надлишок переноситься через американську допомогу." } }
      }
    },
    "rules.wien.poolClosing" : {
      "comment" : "Wien shared-pool explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Individual pools stay open; the match ends when the shared table total is reached." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Личные пули остаются открытыми; матч заканчивается при достижении общего итога стола." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Особисті пулі залишаються відкритими; матч завершується після досягнення спільного підсумку столу." } }
      }
    },
    "rules.odesa.whist" : {
      "comment" : "Odesa whist explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Greedy, responsible whist: each defender writes their own tricks and bears the full quota penalty." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Жлобский ответственный вист: каждый защитник пишет свои взятки и полностью отвечает за норму." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Жлобський відповідальний віст: кожен захисник пише свої взятки й повністю відповідає за норму." } }
      }
    },
    "rules.stalingrad" : {
      "comment" : "Optional Stalingrad six-spade defense rule title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Six-spade defense" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вист на шести пиках" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Віст на шести піках" } }
      }
    },
    "rules.stalingrad.enabled" : {
      "comment" : "Explains that the optional Stalingrad convention is active.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stalingrad is on: both defenders must whist against 6♠ and play with closed hands." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "«Сталинград» включён: против 6♠ оба защитника обязаны вистовать и играть втёмную." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "«Сталінград» увімкнено: проти 6♠ обидва захисники зобов’язані вістувати й грати втемну." } }
      }
    },
    "rules.stalingrad.disabled" : {
      "comment" : "Explains that six spades uses normal whist decisions when Stalingrad is off.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Standard setting: 6♠ follows the ordinary whist choice; Stalingrad is not implied." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Стандартная настройка: на 6♠ решение о висте принимается как обычно; «Сталинград» не включён." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Стандартне налаштування: на 6♠ рішення про віст ухвалюється як зазвичай; «Сталінград» не ввімкнено." } }
      }
    },
    "rules.wien.whist" : {
      "comment" : "Wien whist explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Gentleman’s, semi-responsible whist: when the declarer remises, defenders split trick remuneration; each still writes full consolation, while a whist remise costs half." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Джентльменский полуответственный вист: при подсаде разыгрывающего защитники делят висты за взятки; консоляцию каждый пишет полностью, а ремиз на висте стоит половину." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Джентльменський напіввідповідальний віст: при підсаді розігрувача захисники ділять вісти за взятки; консоляцію кожен пише повністю, а реміз на вісті коштує половину." } }
      }
    },
    "rules.rostov.whist" : {
      "comment" : "Rostov whist explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Rostov whist: ordinary trick payments keep the standard value; a failed whist writes half the game value to mountain, gentleman whist splits a failed deal's trick payments and consolation, and each defender adds ten direct whists per missing declarer trick." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ростовский вист: обычные висты за взятки сохраняют стандартную стоимость; при ремизе виста половина стоимости игры записывается в гору, джентльменский вист делит выплаты за взятки и консоляцию, а каждый защитник пишет по десять прямых вист за каждую недобранную разыгрывающим взятку." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ростовський віст: звичайні вісті за взятки мають стандартну вартість; за ремізу вісту половина вартості гри записується в гору, джентльменський віст ділить виплати за взятки й консоляцію, а кожен захисник пише по десять прямих вістів за кожну недобрану розігрувачем взятку." } }
      }
    },
    "rules.talon" : {
      "comment" : "Raspasy talon-lead rule title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talon lead" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ход прикупа" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Хід прикупу" } }
      }
    },
    "rules.talon.explanation" : {
      "comment" : "Explains classic talon-led raspasy at three- and four-player tables.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talon cards are opened one at a time and lead the first two raspasy tricks. With three players only their suit matters; with four, the sitting-out dealer owns each card and may take the trick." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Карты прикупа открываются по одной и задают первые два хода на распасах. При игре втроём учитывается только масть; вчетвером каждая карта принадлежит не играющему сдатчику, который может взять взятку." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Карти прикупу відкриваються по одній і задають перші два ходи на розпасах. У грі втрьох враховується лише масть; учетверо кожна карта належить здавачу, який не грає й може взяти взятку." } }
      }
    },
    "rules.rostov.talon" : {
      "comment" : "Rostov hidden-talon raspasy explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The talon stays hidden and does not lead raspasy tricks; all-pass pricing stays fixed at five direct whists per trick." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Прикуп остаётся закрытым и не задаёт ход на распасах; стоимость распасов всегда фиксирована — по пять прямых вистов за взятку." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Прикуп залишається закритим і не задає хід на розпасах; вартість розпасів завжди фіксована — по п’ять прямих вістів за взятку." } }
      }
    },
    "rules.dealerTalon" : {
      "comment" : "Four-player sitting-out dealer compensation rule label.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Four-player dealer" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сдатчик вчетвером" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Здавач учетверо" } }
      }
    },
    "rules.dealerTalon.classic" : {
      "comment" : "Compact label for enabled classic dealer talon compensation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talon compensation" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Компенсация за прикуп" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Компенсація за прикуп" } }
      }
    },
    "rules.dealerTalon.none" : {
      "comment" : "Compact label for disabled dealer talon compensation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No talon bonus" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Без бонуса за прикуп" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Без бонусу за прикуп" } }
      }
    },
    "rules.dealerTalon.explanation" : {
      "comment" : "Explains classic talon compensation for the sitting-out fourth player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The sitting-out dealer writes whists on the declarer for classic talon combinations: two aces, a suited ace–king, one ace, or a suited king–queen. On misère, sevens are compensated." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не играющий сдатчик пишет висты на разыгрывающего за комбинации в прикупе: два туза, туз–король одной масти, один туз или марьяж король–дама. На мизере учитываются семёрки." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Здавач, який не грає, пише вісти на розігрувача за комбінації в прикупі: два тузи, туз–король однієї масті, один туз або мар'яж король–дама. На мізері враховуються сімки." } }
      }
    },
    "rules.dealerTalon.none.explanation" : {
      "comment" : "Explains that dealer talon compensation is disabled.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The sitting-out dealer receives no score from the talon." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не играющий сдатчик не получает записей за прикуп." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Здавач, який не грає, не отримує записів за прикуп." } }
      }
    },
    "Continue as Guest" : {
      "comment" : "Online registration button that creates a server-issued guest account.",
