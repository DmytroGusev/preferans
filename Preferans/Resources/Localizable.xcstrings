    "convention.legend.intro": {
      "comment": "Intro paragraph at the top of the convention-legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names we use at our table. Standard Preferans calls these Sochi, Leningrad, Rostov, and Stalingrad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия, которыми мы пользуемся за нашим столом. В стандартном преферансе они звучат как Сочи, Ленинград, Ростов и Сталинград."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви, якими ми користуємося за нашим столом. У стандартному преферансі вони звучать як Сочі, Ленінград, Ростов і Сталінград."
          }
        }
      }
    },
    "convention.legend.outro": {
      "comment": "Footer paragraph at the bottom of the convention-legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside our circle, players will know the standard names — fall back to those when playing with strangers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За пределами нашего круга игроки знают стандартные названия — с незнакомыми соперниками используйте их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поза нашим колом гравці знають стандартні назви — з незнайомими суперниками використовуйте їх."
          }
        }
      }
    },
