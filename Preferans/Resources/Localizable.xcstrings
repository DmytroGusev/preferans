  "strings": {
    "Start a table" : {
      "comment" : "Lobby online panel title for the host path (variant/seats/create-invite).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start a table"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создать стол"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створити стіл"
          }
        }
      }
    },
    "Add your name above to create a table." : {
      "comment" : "Quiet hint under the disabled create-invite CTA when the display name is missing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your name above to create a table."
