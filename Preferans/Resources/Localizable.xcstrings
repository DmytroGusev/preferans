        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкажіть ім'я вище, щоб створити стіл."
          }
        }
      }
    },
    "Tap the code to copy it, or read it to your friends." : {
      "comment" : "Waiting room caption under the room code when there is no share link.",
