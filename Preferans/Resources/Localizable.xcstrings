    "convention.odesa.standard": {
      "comment": "Standard Preferans name that Одеса replaces, shown in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Sochi (Сочинка)" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сочи (Сочинка)" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Сочі (Сочинка)" } }
      }
    },
    "convention.odesa.tradition": {
      "comment": "Tradition tag for Одеса in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ukrainian" } },
        "ru": { "stringUnit": { "state": "translated", "value": "украинская" } },
        "uk": { "stringUnit": { "state": "translated", "value": "українська" } }
      }
    },
    "convention.odesa.summary": {
      "comment": "One-paragraph summary for Одеса in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default balanced scoring. The Russian proverb «знал бы прикуп, жил бы в Сочи» localises cleanly: «знав би прикуп, жив би в Одесі» — same Black Sea coast, same prosperous-port reputation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базовый сбалансированный счёт. Поговорка «знал бы прикуп, жил бы в Сочи» естественно ложится на украинский вариант — «знав би прикуп, жив би в Одесі»: то же Чёрное море, та же репутация процветающего порта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базовий збалансований підрахунок. Приказка «знал бы прикуп, жил бы в Сочи» природно лягає на «знав би прикуп, жив би в Одесі» — те саме Чорне море, та сама слава заможного порту."
          }
        }
      }
    },
    "convention.wien.standard": {
      "comment": "Standard Preferans name that Wien replaces, shown in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Leningrad (Ленінградка)" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ленинград (Ленинградка)" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Ленінград (Ленінградка)" } }
      }
    },
    "convention.wien.tradition": {
      "comment": "Tradition tag for Wien in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Austrian" } },
        "ru": { "stringUnit": { "state": "translated", "value": "австрийская" } },
        "uk": { "stringUnit": { "state": "translated", "value": "австрійська" } }
      }
    },
    "convention.wien.summary": {
      "comment": "One-paragraph summary for Wien in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict, doubled-points variant. Vienna is the actual birthplace of the game — Russian Preferans descends from 19th-century Habsburg Préférence — so the strict-and-classical variant takes its name from where the game was actually invented."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строгий вариант с удвоенными очками. Вена — настоящая родина игры: русский преферанс пошёл от австрийского Préférence XIX века, и «строгий, классический» вариант берёт имя того города, где игра и появилась."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Строгий варіант із подвоєними очками. Відень — справжня батьківщина гри: російський преферанс походить від австрійського Préférence ХІХ століття, тож «строгий, класичний» варіант бере ім’я того міста, де гру й винайшли."
          }
        }
      }
    },
    "convention.thessaloniki.standard": {
      "comment": "Standard Preferans name that Θεσσαλονίκη replaces, shown in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Rostov" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ростов" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Ростов" } }
      }
    },
    "convention.thessaloniki.tradition": {
      "comment": "Tradition tag for Θεσσαλονίκη in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Greek" } },
        "ru": { "stringUnit": { "state": "translated", "value": "греческая" } },
        "uk": { "stringUnit": { "state": "translated", "value": "грецька" } }
      }
    },
    "convention.thessaloniki.summary": {
      "comment": "One-paragraph summary for Θεσσαλονίκη in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggressive, fast-paced variant: no dump points, halved whist penalties, bold bidding rewarded. Thessaloniki — Greece’s mercantile second city — fits the energy, and tips a hat to Greek Prefa, our game’s closest living relative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агрессивный, быстрый вариант: без штрафных очков в гору, висты вдвое меньше, смелые заявки в плюс. Салоники — торговый второй город Греции — подходят по характеру, плюс это поклон греческому преферансу, ближайшему родственнику нашей игры."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агресивний, швидкий варіант: без штрафних очок у гору, вісти вдвічі менші, сміливі заявки в плюс. Салоніки — торговельне друге місто Греції — пасують за характером, до того ж це уклін грецькому преферансу, найближчому родичу нашої гри."
          }
        }
      }
    },
    "convention.kruty.standard": {
      "comment": "Standard Preferans name that Крути replaces, shown in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Stalingrad" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сталинград" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Сталінград" } }
      }
    },
    "convention.kruty.tradition": {
      "comment": "Tradition tag for Крути in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ukrainian" } },
        "ru": { "stringUnit": { "state": "translated", "value": "украинская" } },
        "uk": { "stringUnit": { "state": "translated", "value": "українська" } }
      }
    },
    "convention.kruty.summary": {
      "comment": "One-paragraph summary for Крути in the legend sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On 6♠ both defenders must whist with closed hands — no opting out. In January 1918 a small force of Ukrainian students and cadets held off a much larger Bolshevik advance on Kyiv at Kruty railway station. Same last-stand emotional logic, drawn from Ukrainian rather than Soviet history."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На 6♠ оба защитника обязаны вистовать втёмную — без опций. В январе 1918 года небольшой отряд украинских студентов и юнкеров сдержал значительно превосходящие силы большевиков на станции Круты под Киевом. Та же логика последнего рубежа, но из украинской, а не советской истории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На 6♠ обидва захисники зобов’язані вістувати в темну — без опцій. У січні 1918 року невеликий загін українських студентів і юнкерів стримав значно переважаючі сили більшовиків під Києвом біля станції Крути. Та сама логіка останнього рубежу, але з української, а не радянської історії."
          }
        }
      }
    },
